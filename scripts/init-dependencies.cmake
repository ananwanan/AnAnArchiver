cmake_minimum_required(VERSION 3.25)
get_filename_component(project_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
if(NOT ANANARCHIVER_DEPENDENCY_MANIFEST)
    set(ANANARCHIVER_DEPENDENCY_MANIFEST "${project_root}/out/dependency-resolution.json")
endif()
set(resolver_arguments --root "${project_root}" --manifest "${ANANARCHIVER_DEPENDENCY_MANIFEST}")
if(ANANARCHIVER_INIT_QT)
    list(APPEND resolver_arguments --with-qt)
endif()
if(ANANARCHIVER_DEPENDENCY_RESTORE AND ANANARCHIVER_DEPENDENCY_VERIFY)
    message(FATAL_ERROR "Dependency restore and verify are mutually exclusive")
elseif(ANANARCHIVER_DEPENDENCY_RESTORE)
    list(APPEND resolver_arguments --restore)
elseif(ANANARCHIVER_DEPENDENCY_VERIFY)
    list(APPEND resolver_arguments --verify)
endif()
execute_process(COMMAND "${Python3_EXECUTABLE}" "${project_root}/scripts/resolve_dependencies.py"
    ${resolver_arguments} WORKING_DIRECTORY "${project_root}" COMMAND_ERROR_IS_FATAL ANY)
