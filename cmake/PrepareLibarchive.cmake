include_guard(GLOBAL)

# Export the verified official revision before applying local compatibility
# fixes. The resolved submodule is never edited by the build.
function(ananarchiver_prepare_libarchive output)
    find_package(Git REQUIRED)
    set(upstream "${PROJECT_SOURCE_DIR}/third_party/libarchive")
    set(patch "${PROJECT_SOURCE_DIR}/cmake/patches/libarchive-compatibility.patch")
    file(SHA256 "${patch}" patch_hash)
    file(READ "${ANANARCHIVER_DEPENDENCY_MANIFEST}" manifest)
    string(JSON count LENGTH "${manifest}" dependencies)
    set(revision "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON path GET "${manifest}" dependencies ${index} path)
            if(path STREQUAL "third_party/libarchive")
                string(JSON revision GET "${manifest}" dependencies ${index} revision)
            endif()
        endforeach()
    endif()
    if(NOT revision)
        message(FATAL_ERROR "The libarchive build requires its resolved official revision")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" rev-parse HEAD
        OUTPUT_VARIABLE actual_revision OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" status --porcelain --untracked-files=no
        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT actual_revision STREQUAL revision OR changes)
        message(FATAL_ERROR "libarchive must be a clean checkout of the resolved official revision")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" apply --check "${patch}"
        RESULT_VARIABLE patch_status OUTPUT_QUIET ERROR_VARIABLE patch_error)
    if(NOT patch_status EQUAL 0)
        message(FATAL_ERROR "The libarchive compatibility patch no longer applies to the selected official source. Review and retire fixes already included upstream; refusing to silently omit or mislabel the patch. ${patch_error}")
    endif()
    string(SHA256 source_id "${revision}\n${patch_hash}")
    string(SUBSTRING "${source_id}" 0 16 source_id)
    set(source "${CMAKE_BINARY_DIR}/dependencies/sources/libarchive-${source_id}")
    set(expected "${revision}\n${patch_hash}\n")
    if(EXISTS "${source}/.prepared")
        file(READ "${source}/.prepared" prepared)
        if(NOT prepared STREQUAL expected)
            message(FATAL_ERROR "The generated libarchive source has an invalid preparation record; use a new build directory")
        endif()
        file(STRINGS "${source}/.patched-files" patched_files)
        foreach(record IN LISTS patched_files)
            string(SUBSTRING "${record}" 0 64 expected_hash)
            string(SUBSTRING "${record}" 65 -1 path)
            file(SHA256 "${source}/${path}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                message(FATAL_ERROR "The generated libarchive source was modified: ${path}; use a new build directory")
            endif()
        endforeach()
    else()
        if(EXISTS "${source}")
            message(FATAL_ERROR "An incomplete libarchive source export exists at ${source}; remove that generated directory before retrying")
        endif()
        file(MAKE_DIRECTORY "${source}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${upstream}" archive --format=tar
            "--output=${source}/upstream.tar" "${revision}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf upstream.tar
            WORKING_DIRECTORY "${source}" COMMAND_ERROR_IS_FATAL ANY)
        file(REMOVE "${source}/upstream.tar")
        execute_process(COMMAND "${GIT_EXECUTABLE}" init --quiet "${source}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" apply --check "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${source}" apply "${patch}"
            COMMAND_ERROR_IS_FATAL ANY)
        file(STRINGS "${patch}" headers REGEX "^\\+\\+\\+ b/")
        set(patched_files "")
        foreach(header IN LISTS headers)
            string(SUBSTRING "${header}" 6 -1 path)
            file(SHA256 "${source}/${path}" hash)
            string(APPEND patched_files "${hash} ${path}\n")
        endforeach()
        file(WRITE "${source}/.patched-files" "${patched_files}")
        file(WRITE "${source}/.prepared" "${expected}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${patch}")
    set(ANANARCHIVER_LIBARCHIVE_PATCH_SHA256 "${patch_hash}" PARENT_SCOPE)
    set(${output} "${source}" PARENT_SCOPE)
endfunction()
