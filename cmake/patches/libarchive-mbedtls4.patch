+DEFINE_TEST(test_archive_psa_crypto)
+{
+#if defined(HAVE_MBEDTLS_PSA_CRYPTO) && defined(ARCHIVE_CRYPTOR_USE_MBED)
+	/* RFC 6070 and RFC 2202 independent known answers catch a writer and
+	 * reader sharing the same broken derivation/authentication code. */
+	unsigned char derived[20];
+	const unsigned char expected_derived[20] = {
+		0x0c, 0x60, 0xc8, 0x0f, 0x96, 0x1f, 0x0e, 0x71, 0xf3, 0xa9,
+		0xb5, 0x24, 0xaf, 0x60, 0x12, 0x06, 0x2f, 0xe0, 0x37, 0xa6
+	};
+	unsigned char key[20];
+	unsigned char mac[20];
+	const unsigned char expected_mac[20] = {
+		0xb6, 0x17, 0x31, 0x86, 0x55, 0x05, 0x72, 0x64, 0xe2, 0x8b,
+		0xc0, 0xb6, 0xfb, 0x37, 0x8c, 0x8e, 0xf1, 0x46, 0xbe, 0x00
+	};
+	size_t mac_len = sizeof(mac);
+	archive_hmac_sha1_ctx ctx;
+	assertEqualInt(0, archive_pbkdf2_sha1("password", 8,
+	    (const uint8_t *)"salt", 4, 1, derived, sizeof(derived)));
+	assertEqualMem(derived, expected_derived, sizeof(derived));
+	memset(key, 0x0b, sizeof(key));
+	assertEqualInt(0, archive_hmac_sha1_init(&ctx, key, sizeof(key)));
+	archive_hmac_sha1_update(&ctx, (const uint8_t *)"Hi ", 3);
+	archive_hmac_sha1_update(&ctx, (const uint8_t *)"There", 5);
+	archive_hmac_sha1_final(&ctx, mac, &mac_len);
+	assertEqualInt(sizeof(mac), mac_len);
+	assertEqualMem(mac, expected_mac, sizeof(mac));
+	archive_hmac_sha1_cleanup(&ctx);
+	/* Too-small final output must report a failed MAC, never leave an
+	 * uninitialized authentication code for a ZIP caller to compare/write. */
+	assertEqualInt(0, archive_hmac_sha1_init(&ctx, key, sizeof(key)));
+	archive_hmac_sha1_update(&ctx, (const uint8_t *)"Hi There", 8);
+	mac_len = 1;
+	archive_hmac_sha1_final(&ctx, mac, &mac_len);
+	assertEqualInt(0, mac_len);
+	archive_hmac_sha1_cleanup(&ctx);
+#else
+	skipping("This build does not select Mbed TLS PSA cryptography");
+#endif
+}
 
