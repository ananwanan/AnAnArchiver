diff --git a/CMakeLists.txt b/CMakeLists.txt
index 2e2251a..126c85f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -873,6 +873,15 @@ IF(ENABLE_MBEDTLS)
     LA_CHECK_INCLUDE_FILE("mbedtls/md.h" HAVE_MBEDTLS_MD_H)
     LA_CHECK_INCLUDE_FILE("mbedtls/pkcs5.h" HAVE_MBEDTLS_PKCS5_H)
     LA_CHECK_INCLUDE_FILE("mbedtls/version.h" HAVE_MBEDTLS_VERSION_H)
+    # Mbed TLS 4 delegates cryptography to TF-PSA-Crypto and removes the
+    # public legacy AES, PBKDF2 and HMAC interfaces. Keep Mbed TLS 2/3 intact.
+    IF(NOT HAVE_MBEDTLS_AES_H)
+      LA_CHECK_INCLUDE_FILE("psa/crypto.h" HAVE_MBEDTLS_PSA_CRYPTO)
+      IF(HAVE_MBEDTLS_PSA_CRYPTO AND NOT WIN32)
+        FIND_PACKAGE(Threads REQUIRED)
+        LIST(APPEND ADDITIONAL_LIBS Threads::Threads)
+      ENDIF()
+    ENDIF()
     CMAKE_POP_CHECK_STATE()
 
   ENDIF(MBEDTLS_FOUND)
@@ -988,8 +997,14 @@ MACRO(CHECK_CRYPTO ALGORITHMS IMPLEMENTATION)
 	ELSEIF("${IMPLEMENTATION}" MATCHES "^MBEDTLS$" AND MBEDTLS_FOUND)
 	    SET(TRY_CRYPTO_REQUIRED_INCLUDES
 	      "${TRY_CRYPTO_REQUIRED_INCLUDES};${MBEDTLS_INCLUDE_DIRS}")
+	    SET(mbedtls_crypto_probe_libs "${MBEDCRYPTO_LIBRARY};${CMAKE_THREAD_LIBS_INIT}")
+	    IF(WIN32 AND HAVE_MBEDTLS_PSA_CRYPTO)
+	        # TF-PSA-Crypto initialization uses BCryptGenRandom even when
+	        # libarchive's native CNG algorithm implementation is disabled.
+	        LIST(APPEND mbedtls_crypto_probe_libs bcrypt)
+	    ENDIF()
 	    SET(TRY_CRYPTO_REQUIRED_LIBS
-	      "-DLINK_LIBRARIES:STRING=${MBEDCRYPTO_LIBRARY}")
+	      "-DLINK_LIBRARIES:STRING=${mbedtls_crypto_probe_libs}")
 	ELSEIF("${IMPLEMENTATION}" MATCHES "^NETTLE$" AND NETTLE_FOUND)
 	    SET(TRY_CRYPTO_REQUIRED_INCLUDES
 	      "${TRY_CRYPTO_REQUIRED_INCLUDES};${NETTLE_INCLUDE_DIR}")
@@ -1012,6 +1027,9 @@ MACRO(CHECK_CRYPTO ALGORITHMS IMPLEMENTATION)
 #define ARCHIVE_${algorithm}_COMPILE_TEST
 #define ARCHIVE_CRYPTO_${algorithm}_${IMPLEMENTATION}
 #define PLATFORM_CONFIG_H \"check_crypto_md.h\"
+#if defined(HAVE_MBEDTLS_PSA_CRYPTO)
+#include \"archive_mbedtls.c\"
+#endif
 
 ${ARCHIVE_CRYPTO_C}
 
