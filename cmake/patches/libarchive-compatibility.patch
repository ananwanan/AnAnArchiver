+    LIST(APPEND ADDITIONAL_LIBS ${MBEDCRYPTO_LIBRARIES})
     INCLUDE_DIRECTORIES(${MBEDTLS_INCLUDE_DIRS})
 
     CMAKE_PUSH_CHECK_STATE()
@@ -873,6 +873,18 @@ IF(ENABLE_MBEDTLS)
     LA_CHECK_INCLUDE_FILE("mbedtls/md.h" HAVE_MBEDTLS_MD_H)
     LA_CHECK_INCLUDE_FILE("mbedtls/pkcs5.h" HAVE_MBEDTLS_PKCS5_H)
     LA_CHECK_INCLUDE_FILE("mbedtls/version.h" HAVE_MBEDTLS_VERSION_H)
+    LA_CHECK_INCLUDE_FILE("psa/crypto.h" HAVE_MBEDTLS_PSA_CRYPTO_H)
+    LA_CHECK_INCLUDE_FILE("tf-psa-crypto/version.h" HAVE_TF_PSA_CRYPTO_VERSION_H)
+    # Mbed TLS 4 / TF-PSA-Crypto removed the legacy public AES and digest
+    # headers. Use only the supported PSA API, never private driver headers.
+    IF(HAVE_MBEDTLS_PSA_CRYPTO_H AND HAVE_TF_PSA_CRYPTO_VERSION_H)
+      SET(ARCHIVE_CRYPTO_MBEDTLS_PSA 1)
+      IF(NOT WIN32)
+        FIND_PACKAGE(Threads REQUIRED)
+        LIST(APPEND ADDITIONAL_LIBS Threads::Threads)
+        LIST(APPEND MBEDCRYPTO_LIBRARIES ${CMAKE_THREAD_LIBS_INIT})
+      ENDIF()
+    ENDIF()
     CMAKE_POP_CHECK_STATE()
 
   ENDIF(MBEDTLS_FOUND)
