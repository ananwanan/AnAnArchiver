     locker.unlock();
     Handle hnd = nullptr;
     for (const QString &attempt : std::as_const(attempts)) {
-        hnd = LoadLibrary(reinterpret_cast<const wchar_t*>(QDir::toNativeSeparators(attempt).utf16()));
+        // File engine paths carry Windows extended-length prefixes for absolute
+        // local and UNC paths. Relative names retain the native loader search.
+        const QFileSystemEntry attemptEntry(attempt);
+        const QString nativeAttempt = attemptEntry.isAbsolute()
+                ? attemptEntry.nativeFilePath() : QDir::toNativeSeparators(attempt);
+        hnd = LoadLibraryW(reinterpret_cast<const wchar_t *>(nativeAttempt.utf16()));
 
         // If we have a handle or the last error is something other than "unable
