[Desktop Entry]
Version=1.0
Type=Application
Name=LiteArc
Name[zh_CN]=轻匣
GenericName=Archive Manager
GenericName[zh_CN]=归档管理器
Comment=Browse, extract and create archives
Comment[zh_CN]=浏览、解压和创建压缩包
Exec=LiteArc %f
